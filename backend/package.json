{
  "name": "remotex-backend",
  "version": "1.0.0",
  "description": "RemoteX High Performance Remote Desktop Backend & Signaling Server",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "prisma generate",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:init": "node utils/dbInit.js",
    "db:migrate": "node utils/dbMigrate.js",
    "db:seed": "node utils/dbSeed.js",
    "db:check": "node utils/dbCheck.js",
    "test": "node --test utils/backendTest.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
