generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum DeviceStatus {
  online
  offline
  busy
}

enum SessionStatus {
  pending
  active
  ended
  rejected
}

enum TransferStatus {
  pending
  in_progress
  completed
  cancelled
  failed
}

model User {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(255)
  email         String          @unique @db.VarChar(255)
  password_hash String          @db.VarChar(255)
  settings      Json?
  created_at    DateTime?       @default(now()) @db.DateTime(0)
  updated_at    DateTime?       @default(now()) @updatedAt @db.DateTime(0)
  
  devices         Device[]
  trusted_devices TrustedDevice[]
  connection_logs ConnectionLog[]

  @@map("users")
}

model Device {
  id                       Int          @id @default(autoincrement())
  user_id                  Int?
  device_name              String       @db.VarChar(255)
  device_code              String       @unique @db.VarChar(64)
  operating_system         String?      @default("Windows") @db.VarChar(100)
  device_status            DeviceStatus? @default(offline)
  unattended_password_hash String?      @db.VarChar(255)
  last_seen                DateTime?    @default(now()) @db.DateTime(0)
  created_at               DateTime?    @default(now()) @db.DateTime(0)

  user             User?           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  host_sessions    Session[]       @relation("HostDevice")
  client_sessions  Session[]       @relation("ClientDevice")
  trusted_in       TrustedDevice[]

  @@index([user_id], map: "idx_devices_user")
  @@index([device_code], map: "idx_devices_code")
  @@index([device_status], map: "idx_devices_status")
  @@map("devices")
}

model Session {
  id               Int           @id @default(autoincrement())
  session_code     String        @unique @db.VarChar(64)
  host_device_id   Int
  client_device_id Int
  session_status   SessionStatus? @default(pending)
  started_at       DateTime?     @default(now()) @db.DateTime(0)
  ended_at         DateTime?     @db.DateTime(0)

  host_device     Device              @relation("HostDevice", fields: [host_device_id], references: [id], onDelete: Cascade)
  client_device   Device              @relation("ClientDevice", fields: [client_device_id], references: [id], onDelete: Cascade)
  permissions     SessionPermission[]
  connection_logs ConnectionLog[]
  file_transfers  FileTransfer[]

  @@index([host_device_id], map: "idx_sessions_host")
  @@index([client_device_id], map: "idx_sessions_client")
  @@index([session_code], map: "idx_sessions_code")
  @@index([session_status], map: "idx_sessions_status")
  @@map("sessions")
}

model SessionPermission {
  id              Int     @id @default(autoincrement())
  session_id      Int
  permission_type String  @db.VarChar(64)
  is_allowed      Boolean @default(false)

  session Session @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@unique([session_id, permission_type], map: "uq_session_permission")
  @@index([session_id], map: "idx_session_permissions_session")
  @@map("session_permissions")
}

model TrustedDevice {
  id         Int       @id @default(autoincrement())
  user_id    Int
  device_id  Int
  created_at DateTime? @default(now()) @db.DateTime(0)

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  device Device @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@unique([user_id, device_id], map: "uq_user_device")
  @@index([user_id], map: "idx_trusted_user")
  @@index([device_id], map: "idx_trusted_device")
  @@map("trusted_devices")
}

model ConnectionLog {
  id         Int       @id @default(autoincrement())
  session_id Int?
  user_id    Int?
  action     String    @db.VarChar(128)
  ip_address String?   @db.VarChar(64)
  created_at DateTime? @default(now()) @db.DateTime(0)

  session Session? @relation(fields: [session_id], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([session_id], map: "idx_logs_session")
  @@index([user_id], map: "idx_logs_user")
  @@index([action], map: "idx_logs_action")
  @@map("connection_logs")
}

model FileTransfer {
  id              Int            @id @default(autoincrement())
  session_id      Int
  file_name       String         @db.VarChar(255)
  file_size       BigInt
  transfer_status TransferStatus? @default(pending)
  created_at      DateTime?      @default(now()) @db.DateTime(0)

  session Session @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id], map: "idx_file_transfers_session")
  @@index([transfer_status], map: "idx_file_transfers_status")
  @@map("file_transfers")
}
