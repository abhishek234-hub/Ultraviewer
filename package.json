{
  "name": "remotex-workspace",
  "version": "1.0.0",
  "description": "RemoteX - Complete Production Windows Remote Desktop System",
  "private": true,
  "scripts": {
    "db:init": "npm --prefix backend run db:init",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "db:check": "npm --prefix backend run db:check",
    "test:backend": "npm --prefix backend test",
    "start:backend": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend run dev",
    "start:frontend": "npm --prefix frontend run electron:dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:installer": "npm --prefix frontend run dist"
  }
}
