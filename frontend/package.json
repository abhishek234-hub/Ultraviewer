{
  "name": "remotex-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "RemoteX Windows Remote Desktop Client",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5174 && electron .\"",
    "electron:start": "electron .",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win nsis:ia32 --win nsis:x64"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.2",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "vite": "^5.4.11",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.remotex.desktop",
    "productName": "RemoteX",
    "copyright": "Copyright © 2026 RemoteX Technologies",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../native-agent/windows/input/bin",
        "to": "native-agent",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico",
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RemoteX Remote Desktop",
      "uninstallDisplayName": "RemoteX Remote Desktop"
    }
  }
}
